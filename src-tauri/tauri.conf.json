{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate",
  "version": "1.1.0",
  "identifier": "com.dylan.projektmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Slate",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QUM2N0QwRDAxMzY2M0UKUldRK1poUFEwR2VzOXBqckxpTlc1d0xvdXNseUxGQzlSaGw5cUdsWnp1WnFPcUZodlc5aVJtSlYK",
      "endpoints": [
        "https://github.com/ItsDylan255/Slate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}